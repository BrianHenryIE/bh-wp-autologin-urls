{
  "name": "brianhenryie/bh-wp-autologin-urls",
  "description": "Adds single-use passwords to emails to WordPress users.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0+-or-later",
  "authors": [
    {
      "name": "Brian Henry",
      "email": "BrianHenryIE@gmail.com"
    }
  ],
  "autoload": {
    "classmap": [
      "src"
    ]
  },
  "autoload-dev": {
    "classmap": [
      "tests/integration",
      "tests/unit",
      "tests/wpunit"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "alleyinteractive/composer-wordpress-autoloader": true,
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "johnpbloch/wordpress-core-installer": true,
      "phpstan/extension-installer": true
    },
    "platform": {
      "php": "8.1"
    },
    "process-timeout": 0,
    "sort-packages": true
  },
  "repositories": {
    "brianhenryie/strauss": {
      "type": "package",
      "package": {
        "name": "brianhenryie/strauss",
        "version": "0.28.1",
        "dist": {
          "url": "https://github.com/BrianHenryIE/strauss/releases/download/0.28.1/strauss.phar",
          "type": "phar"
        },
        "installation-source": "dist",
        "bin": "bin/strauss"
      }
    },
    "outlandishideas/wpackagist": {
      "type": "composer",
      "url": "https://wpackagist.org"
    },
    "brianhenryie/bh-wp-rate-limiter": {
      "url": "../bh-wp-rate-limiter",
      "type": "path"
    },
    "wordpress/wordpress": {
      "url": "https://github.com/WordPress/wordpress-develop",
      "type": "git"
    }
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "alleyinteractive/wordpress-autoloader": "^1.1",
    "brianhenryie/bh-wp-logger": "*",
    "brianhenryie/bh-wp-rate-limiter": "dev-master",
    "klaviyo/sdk": "^1.0"
  },
  "require-dev": {
    "ext-dom": "*",
    "10up/wp_mock": "*",
    "antecedent/patchwork": "^2.1",
    "brianhenryie/color-logger": "*",
    "brianhenryie/strauss": "0.28.1",
    "codeception/module-asserts": "^1.0",
    "codeception/module-cli": "^1.0",
    "codeception/module-db": "^1.0.0",
    "codeception/module-filesystem": "^1.0",
    "codeception/module-phpbrowser": "^1.0.0",
    "codeception/module-webdriver": "^1.0",
    "codeception/util-universalframework": "^1.0",
    "dealerdirect/phpcodesniffer-composer-installer": "*",
    "johnpbloch/wordpress": "*",
    "lucatume/wp-browser": "*",
    "php-stubs/woocommerce-stubs": "*",
    "phpcompatibility/phpcompatibility-wp": "*",
    "phpstan/extension-installer": "*",
    "phpstan/phpstan": "*",
    "phpunit/phpcov": "*",
    "squizlabs/php_codesniffer": "*",
    "szepeviktor/phpstan-wordpress": "*",
    "woocommerce/woocommerce-sniffs": "*",
    "wordpress/wordpress": "*",
    "wp-cli/dist-archive-command": "*",
    "wp-cli/i18n-command": "^2.4",
    "wp-cli/profile-command": "^2.1",
    "wp-cli/wp-cli-bundle": "*",
    "wp-coding-standards/wpcs": "*",
    "wpackagist-plugin/document-generator-for-openapi": "^1.1",
    "wpackagist-plugin/give": "*",
    "wpackagist-plugin/mailpoet": "*",
    "wpackagist-plugin/newsletter": "*",
    "wpackagist-plugin/woocommerce": "*",
    "wpackagist-plugin/wp-mail-debugger": "*",
    "wpackagist-plugin/wp-mail-logging": "*",
    "wpackagist-plugin/wp-mail-smtp": "*",
    "wpackagist-plugin/wp-super-cache": "*",
    "wpackagist-theme/storefront": "*",
    "wpackagist-theme/twentytwenty": "*"
  },
  "extra": {
    "patches": {
      "jaschilz/php-coverage-badger": {
        "Allow customising the text": "https://github.com/JASchilz/PHPCoverageBadge/pull/1.patch"
      }
    },
    "strauss": {
      "namespace_prefix": "BrianHenryIE\\WP_Autologin_URLs\\",
      "classmap_prefix": "BH_WP_Autologin_URLs_",
      "namespace_replacement_patterns": {
        "~BrianHenryIE\\\\(.*)~" : "BrianHenryIE\\WP_Autologin_URLs\\\\$1"
      },
      "exclude_from_prefix": {
        "packages": [
          "psr/log"
        ]
      },
      "exclude_from_copy": {
        "file_patterns": [
          "~psr/log/Psr/Log/Test.*~"
        ]
      }
    }
  },
  "scripts": {
    "post-install-cmd": [
      "strauss",
      "@sync-composer-wpenv"
    ],
    "post-update-cmd": [
      "strauss",
      "@sync-composer-wpenv"
    ],
    "test": [
      "codecept run unit",
      "codecept run wpunit"
    ],
    "test-coverage": [
      "mkdir -p tests/_output/html/phpunit",
      "codecept run unit --coverage unit.cov",
      "codecept run wpunit --coverage wpunit.cov",
      "phpcov merge --clover tests/_output/clover.xml --html tests/_output/html/phpunit tests/_output;",
      "open tests/_output/html/phpunit/index.html"
    ],
    "cs-fix": [
      "phpcbf || true",
      "phpcs || true",
      "phpstan analyse --memory-limit 2G"
    ],
    "cs-fix-changes": [
      "updated_files=$( git status | grep 'modified:\\s.*.php$' | cut -c14- | awk '{ printf(\"%s \", $0) }' ); phpcbf $(echo $updated_files); phpcs $(echo $updated_files); phpstan analyse $(echo $updated_files) --memory-limit 2G"
    ],
    "php-compatibility": [
      "phpcs -p includes templates vendor-prefixed --standard=PHPCompatibilityWP --runtime-set testVersion 8.0-"
    ],
    "create-plugin-archive": [
      "wp i18n make-pot src languages/$(basename \"$PWD\").pot --domain=$(basename \"$PWD\")",
      "wp dist-archive . ./dist-archive --plugin-dirname=$(basename \"$PWD\") --create-target-dir"
    ],
    "github-actions": [
      "act -P ubuntu-latest=shivammathur/node:latest"
    ],
    "sync-composer-wpenv": [
      "@php bin/sync-composer-wpenv.php"
    ],
    "generate-openapi": [
      "npx wp-env run cli /var/www/html/wp-content/plugins/bh-wp-autologin-urls/vendor/bin/wp openapi-generator export-file bh-wp-autologin-urls/v1 --destination=./openapi/bh-wp-autologin-urls-openapi.json --extract-common-types;",
      "npx wp-env run cli /var/www/html/wp-content/plugins/bh-wp-autologin-urls/vendor/bin/wp openapi-generator export-file wp/v2 --destination=./openapi/wp-v2-settings-openapi.json --extract-common-types;",
      "cat ./openapi/bh-wp-autologin-urls-openapi.json | jq 'del(.servers) | del(.paths.\"/\") | .jsonSchemaDialect = \"https://spec.openapis.org/oas/3.1/dialect/base\"' | sponge ./openapi/bh-wp-autologin-urls-openapi.json"
    ],
    "generate-wp-cli-docs": [
      "npx wp-env run cli /var/www/html/wp-content/plugins/example-plugin/vendor/bin/wp handbook gen-custom example-plugin --output_dir=docs/wp-cli;",
      "rm -rf docs/wp-cli/example-plugin/logger; rm docs/wp-cli/example-plugin/logger.md;"
    ]
  }
}
